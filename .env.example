# Copy to .env and fill in what you have. .env is git- and docker-ignored: never commit it.
# Leave the keys empty to run in mock mode (no accounts needed; see README "Run it with no accounts").

# Meta Model API (SAM 3.1, Muse Spark, Muse Wonder, Muse Image, Muse Voice Transcribe)
META_API_KEY=
# Muse Spark Open, the open-weights model that drafts every building. It runs on Baseten by default.
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open
# Any OpenAI-compatible server hosting Muse Spark Open instead of Baseten (vLLM, for example):
# OPEN_MODEL_URL=http://localhost:8001/v1/chat/completions

# Optional: Mapillary street-level photos (free client token, https://www.mapillary.com/dashboard/developers)
# MAPILLARY_ACCESS_TOKEN=

# 1 forces mock mode even with keys set: fixed rules instead of the models, replayed example runs
# LANDFALL_MOCK=1
# A hosted copy can require this code before running new assessments (they spend API credits)
# LANDFALL_ACCESS_CODE=
# Where drawn areas are stored (default ./data)
# LANDFALL_DATA=data
